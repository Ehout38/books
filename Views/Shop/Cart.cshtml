@model CartViewModel
@{
    ViewData["Title"] = "Cart";
}
<h1>Your cart</h1>
@if (Model.Count == 0)
{
    <section class="panel">
        <p>Your cart is empty.</p>
        <a class="button" asp-action="Index">Browse products</a>
    </section>
}
else
{
    <partial name="_CartItems" model="Model.Items" />
    <p class="total">@Model.Count items. Total: $@Model.Total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</p>
    <div class="actions">
        @foreach (var item in Model.Items)
        {
            <form asp-action="Remove" method="post">
                <input type="hidden" name="id" value="@item.ProductId" />
                <button class="secondary" type="submit">Remove @item.Name</button>
            </form>
        }
    </div>
    <div class="actions">
        <a class="button" asp-action="Checkout">Checkout</a>
        <a asp-action="Index">Continue shopping</a>
        <form asp-action="Clear" method="post">
            <button class="secondary" type="submit">Clear cart</button>
        </form>
    </div>
}
