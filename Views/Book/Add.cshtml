@model BookViewModel
@{
    ViewData["Title"] = "Add book";
}
<h1>Add book</h1>
<form asp-action="Add" method="post" class="panel form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label asp-for="Title"></label>
    <input asp-for="Title" required maxlength="120" />
    <span asp-validation-for="Title" class="validation"></span>
    <label asp-for="Author"></label>
    <input asp-for="Author" required maxlength="100" />
    <span asp-validation-for="Author" class="validation"></span>
    <label asp-for="Genre"></label>
    <input asp-for="Genre" required maxlength="60" />
    <span asp-validation-for="Genre" class="validation"></span>
    <label asp-for="Year"></label>
    <input asp-for="Year" min="1" max="@DateTime.Now.Year" required />
    <span asp-validation-for="Year" class="validation"></span>
    <div class="actions">
        <button type="submit">Save book</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
